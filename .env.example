# ══════════════════════════════════════════════════════════════════════════
#  CRM de Banco Demo · configuración
#
#  Cópialo a `.env.local`. NADA de este fichero es visible desde el navegador:
#  no hay ni una variable `NEXT_PUBLIC_*`, y los módulos que las leen son
#  `server-only`, así que importarlos desde un componente de cliente es un
#  error de compilación y no un descuido que se descubre en producción.
# ══════════════════════════════════════════════════════════════════════════

# ── La base propia del CRM ────────────────────────────────────────────────
#
# Es SUYA: ni te-api ni Logto la leen nunca. `npm run db:migrate` crea la tabla.
DATABASE_URL=postgres://crm:crm@localhost:5432/crm_demo


# ── Logto · de dónde sale el token M2M de organización ────────────────────
#
# Un solo Logto para todas las organizaciones, así que esto es global.
LOGTO_ENDPOINT=https://auth.idp.tripleenable.com

# El indicador del recurso B2B de te-api. Es el `aud` que te-api exige, y es
# DISTINTO del recurso de la cartera: esa separación es lo que hace que un token
# de cartera no llegue nunca a las rutas B2B, y al revés. Tiene que ser
# exactamente el mismo texto que `TE_B2B_RESOURCE` en te-api, carácter a
# carácter — una barra final de más y el token sale para otro recurso y te-api
# contesta el mismo 404 que a un intruso.
TE_B2B_RESOURCE=https://te-api.idp.tripleenable.com/v1/b2b

# El scope de emisión. Se pide explícito porque Logto no lo da por defecto.
# TE_B2B_SCOPE=credentials:issue

# La base de te-api. Sirve de respaldo para el `ISSUER_URL` y el `VERIFIER_URL`
# de cada organización, que es lo normal mientras haya un solo despliegue.
TE_API_BASE_URL=https://te-api.idp.tripleenable.com


# ── Las organizaciones ────────────────────────────────────────────────────
#
# El mapa `orgId → { m2mClientId, m2mSecret, issuerUrl, verifierUrl }` se
# declara por prefijo. El SLUG va en MAYÚSCULAS y SIN GUIONES BAJOS (el
# descubrimiento busca las claves que acaban en `_ID`, y con guiones bajos
# `..._M2M_CLIENT_ID` se leería como otra organización).
#
# Añadir el segundo banco es copiar este bloque con otro slug. No se toca código.

CRM_ORG_BANCODEMO_ID=<organization_id de Banco Demo en Logto>
CRM_ORG_BANCODEMO_NAME=Banco Demo, S.A.

# La aplicación M2M de ESA organización en Logto, con el rol de organización
# que lleva el scope `credentials:issue`. Logto se niega a emitir un token para
# una organización de la que la app no es miembro, así que este par de valores
# es lo que ata este CRM a este banco.
#
# ⚠ El secreto sólo vive aquí y en el servidor. Nunca en el repositorio.
CRM_ORG_BANCODEMO_M2M_CLIENT_ID=<app id M2M>
CRM_ORG_BANCODEMO_M2M_SECRET=<app secret M2M>

# Bases de te-api para emitir y para verificar. Si no se ponen, se usa
# TE_API_BASE_URL.
#
# ⚠ Aquí va te-api, NUNCA walt.id. El emisor de walt.id no tiene autenticación
#   ninguna y publica las claves privadas de sus perfiles: lo único que lo
#   protege es no tener dominio. El CRM no lo llama jamás.
# CRM_ORG_BANCODEMO_ISSUER_URL=https://te-api.idp.tripleenable.com
# CRM_ORG_BANCODEMO_VERIFIER_URL=https://te-api.idp.tripleenable.com


# ── La sesión del empleado ────────────────────────────────────────────────
#
# El login de empleado con Logto OIDC es la casilla de F4a que queda PENDIENTE.
# Mientras no esté, la organización activa de la consola se fija aquí. Con una
# sola organización declarada se puede omitir.
#
# Esto NO autentica nada contra te-api: lo único que autoriza esas llamadas es
# el token M2M de arriba. Sirve para saber qué clientes se enseñan y a quién se
# atribuye la operación.
CRM_ACTIVE_ORG_ID=<el mismo organization_id de arriba>

# Etiqueta del operador para el diario, mientras no haya login.
# CRM_ACTIVE_ACTOR=crm:mostrador-1


# ── F2 · El portal de clientes (/portal) ──────────────────────────────────
#
# `/portal` es la OTRA sección del CRM: la consola de agentes la usa un empleado
# del banco; el portal lo usa el titular, entrando con SU cuenta de TripleEnable.
# De ese login sale el ID token que el servidor manda a `POST /v1/b2b/links` de
# te-api, y es lo único con lo que se puede probar un vínculo — te-api no acepta
# que el banco declare a quién vincula.
#
# La aplicación de Logto es de tipo **Traditional Web** (no M2M, no SPA): el
# canje del código ocurre en el servidor del CRM. Su `redirect_uri` declarada en
# la consola tiene que ser `<CRM_PORTAL_BASE_URL>/portal/callback`, carácter a
# carácter.
#
# ⚠ Su `client_id` es además el `portal_client_id` que hay que sembrar en te-api:
#
#     TE_PARTNER_PORTAL_CLIENT_ID=<el mismo valor> npm run seed:partner
#
#   te-api lo usa como `aud` obligatorio del ID token. Si los dos no coinciden,
#   `POST /v1/b2b/links` responde `403 cannot_complete` y no dice por qué.
#
# Las dos van juntas o no van: con el id y sin el secreto, el login llega hasta
# el canje del código y muere allí, con la persona ya autenticada.
# CRM_ORG_BANCODEMO_PORTAL_CLIENT_ID=<app id de la aplicación Traditional Web>
# CRM_ORG_BANCODEMO_PORTAL_CLIENT_SECRET=<su app secret>

# El `type` que el portal declara al vincular. Opcional: el vínculo nace del
# login y no de la credencial. Tiene que ser un `type_key` del padrón de ESA
# organización en te-api, o la llamada sale con `400 invalid_request`.
# CRM_ORG_BANCODEMO_PORTAL_LINK_TYPE=cliente

# La dirección pública del portal. De aquí sale el `redirect_uri` y a aquí
# vuelven las redirecciones internas — se compone de esta variable y NUNCA de la
# cabecera `Host` de la petición, que la escribe quien llama.
CRM_PORTAL_BASE_URL=http://localhost:3000

# Firma la cookie de sesión del portal (HS256). 32 caracteres o más.
# Sin ella el portal no arranca: una sesión sin firmar la escribe cualquiera.
CRM_PORTAL_COOKIE_SECRET=<32+ caracteres aleatorios>
